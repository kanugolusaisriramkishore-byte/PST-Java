interface PerformOperation {
    boolean check(int a);
}

class MyMath {

    // 1. Check Odd / Even
    public PerformOperation isOdd() {
        return (n) -> n % 2 != 0;
    }

    // 2. Check Prime / Composite
    public PerformOperation isPrime() {
        return (n) -> {
            if (n < 2) {
                return false;
            }

            for (int i = 2; i * i <= n; i++) {
                if (n % i == 0) {
                    return false;
                }
            }

            return true;
        };
    }

    // 3. Check Palindrome
    public PerformOperation isPalindrome() {
        return (n) -> {
            int original = n;
            int reverse = 0;

            while (n > 0) {
                int digit = n % 10;
                reverse = reverse * 10 + digit;
                n /= 10;
            }

            return original == reverse;
        };
    }
}
